print "How many numbers?"
i64: N, i              # counts are integers
f64: num, sum          # the numbers themselves are f64
input N

while i < N {
    print "\nEnter number:"
    input num
    sum = sum + num
    i = i + 1
}
print "Sum ="
print sum

avg = sum / f64(N)     # f64 / i64 does not mix: convert N explicitly
print "Average ="
print avg
