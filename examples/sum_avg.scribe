print "How many numbers?"
N = 0                  # how many: an integer
input N

i = 0
num = 0.0              # the numbers themselves are f64
sum = 0.0
while i < N {
    print "\nEnter number:"
    input num
    sum = sum + num
    i = i + 1
}
print "Sum ="
print sum

avg = sum / f64(N)     # f64 / i64 does not mix: convert N explicitly
print "Average ="
print avg
