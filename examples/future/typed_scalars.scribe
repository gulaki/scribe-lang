# PROPOSAL (v0.2): explicit scalar types, checked arithmetic.
# Not supported yet. See docs/design/type-system.md.

count: int = 10               # 64-bit signed
ratio: float = 0.5            # IEEE-754 binary32
done: bool = false

big := 3_000_000_000          # `:=` infers from a literal: int
half := 0.5                   # float

total: float = float(count) * ratio   # no implicit int -> float
whole: int = int(total)               # explicit; traps if out of range or NaN

# Arithmetic is checked: overflow is a defined runtime trap, never UB.
# Operators with a % suffix opt in to wrapping, and say so at the call site.
wrapped: int = count +% 9_223_372_036_854_775_807

if count > 5 and not done {
    print "counting"
}
