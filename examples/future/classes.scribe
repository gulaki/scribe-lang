# PROPOSAL (v0.7): classes, constructors, methods, scope-based cleanup.
# No pointers are visible. The compiler decides stack vs heap by escape
# analysis and inserts the frees. See docs/design/memory-model.md.

class Account {
    i64: balance                         # fields are declarations
    str: owner

    fn deposit(mut self, i64: amount) {
        require amount > 0               # contract: violation traps, never UB
        self.balance = self.balance + amount
    }

    fn describe(self) -> str {
        return self.owner + ": " + str(self.balance)   # str(...) is a cast
    }
}

fn open_for(str: name) -> Account {
    a = Account(0, name)                 # inferred type; escapes via return
    return a                             # moved out: no copy, no free here
}

fn demo() {
    tmp = Account(5, "temp")             # does not escape: lives on the stack
    tmp.deposit(10)
    print tmp.describe()
}                                        # tmp cleaned up here, on every path

acct = open_for("ada")                   # heap object owned by acct
acct.deposit(100)
print acct.describe()
