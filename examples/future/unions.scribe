# PROPOSAL (v0.6): tagged unions and exhaustive match.
# A union is a C struct { tag; union { ... } }; the tag is always checked.

type Number = i64 | f64

fn double(Number: n) -> Number {
    match n {
        i64 i => return i * 2
        f64 f => return f * 2.0
    }                          # missing a case would be a compile error
}

fn parse(str: text) -> i64 | ParseError {
    # ...
}

r = parse("42")
match r {
    i64 i        => print i
    ParseError e => print "bad input: " + e.message
}

# A union argument to a plain overloaded call is allowed only if EVERY member
# resolves; the compiler then emits the dispatch switch itself.
print describe(double(21))
