# Primes up to a limit, by trial division.
# Showcases: nested loops, `goto` as a "break/continue", and a remainder
# computed with repeated subtraction (Scribe has no `%` operator).
print "Print primes up to:"
input limit

n = 2
while n <= limit {
    d = 2
    while d * d <= n {
        r = n                  # r ends up as n mod d
        while r >= d {
            r = r - d
        }
        if r == 0 {
            goto composite     # leaves all three loops at once
        }
        d = d + 1
    }
    print n                    # reached only when no divisor was found
    label composite
    n = n + 1
}
