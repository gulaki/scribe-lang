# Primes up to a limit, by trial division.
# Showcases: nested loops, `%`, and `goto` as a "break/continue".
print "Print primes up to:"
i64: limit             # declared i64, so `input` reads a whole number
input limit

n = 2
while n <= limit {
    d = 2
    while d * d <= n {
        if n % d == 0 {
            goto composite     # leaves both loops at once
        }
        d = d + 1
    }
    print n                    # reached only when no divisor was found
    label composite
    n = n + 1
}
