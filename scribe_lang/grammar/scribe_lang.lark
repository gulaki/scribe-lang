// Scribe lang grammar.
// Keep syntax here, not in Python. This is the primary language-definition file.
//
// Statements are separated (not terminated) by newlines or ';'. That is what
// lets a block fit on one line:   if x > 0 { print x; x = x - 1 }

start: program

program: _sep? _stmt_list?

// One or more statements with separators between them. Leading and trailing
// separators are allowed so blank lines and comment-only lines are harmless.
_stmt_list: statement (_sep statement)* _sep?
_sep: (_NL | ";")+

?statement: print_stmt
          | input_stmt
          | let_stmt
          | multi_let_stmt
          | decl_stmt
          | if_stmt
          | while_stmt
          | block
          | label_stmt
          | goto_stmt

print_stmt: PRINT (STRING | expression)
input_stmt: INPUT IDENT
// `a = b = c = 0` is chained assignment: c = 0, then b = c, then a = b.
// `a, b = x, y` evaluates every value, then assigns: `a, b = b, a` swaps.
// Unequal counts (`a = 1, 2`, `a, b = 1`) parse, so semantics can explain
// the mismatch.
let_stmt: (IDENT "=")+ expression ("," expression)*
multi_let_stmt: IDENT ("," IDENT)+ "=" expression ("," expression)*

// `i64: a, b = 5, c` declares a, b and c, each zero unless given a value.
decl_stmt: type_name ":" declarator ("," declarator)*
declarator: IDENT ("=" expression)?

// `}` and the next `elif` / `else` must be on the same line (K&R style).
// A condition is any expression; semantics requires a bool or an integer.
if_stmt: IF expression block (ELIF expression block)* (ELSE block)?
while_stmt: WHILE expression block

// A block is a scope. LBRACE/RBRACE are named so their positions survive into
// the parse tree and can be attached to AST nodes.
block: LBRACE _sep? _stmt_list? RBRACE

label_stmt: LABEL IDENT
goto_stmt: GOTO IDENT

// Precedence, loosest first, as in Python:
//   or < and < not < comparisons < + - < * / // % < unary - + < **
// `and` and `or` are left-associative. `a < b <= c` is one chained
// comparison, meaning `a < b and b <= c`.
?expression: or_expr
?or_expr: and_expr (OR and_expr)*
?and_expr: not_expr (AND not_expr)*
?not_expr: NOT not_expr
         | comparison
?comparison: sum (COMP_OP sum)*
?sum: term (ADD_OP term)*
?term: unary (MUL_OP unary)*
?unary: SIGN? power
// `**` is right-associative and binds tighter than a sign on its left, as in
// Python: `-2 ** 2` is -(2 ** 2), `2 ** 3 ** 2` is 2 ** 9, and the exponent
// may have a sign (`2.0 ** -1`).
?power: primary (POW_OP unary)?
?primary: INT_LIT       -> int_literal
        | FLOAT_LIT     -> float_literal
        | TRUE          -> true_literal
        | FALSE         -> false_literal
        | IDENT         -> variable
        | "(" expression ")" -> grouped
        | type_name "(" expression ")" -> cast

// A cast is written like a call: `f64(n)`. Only these types can be named
// today (in casts and declarations); see the reserved type names below.
type_name: I64 | F32 | F64 | BOOL

ADD_OP: "+" | "-"
// `//` before `/`, so `a // b` is never lexed as two divisions.
MUL_OP: "*" | "//" | "/" | "%"
POW_OP.2: "**"  // before MUL_OP, so `**` is never two `*`
SIGN: "+" | "-"
COMP_OP: "==" | "!=" | ">=" | "<=" | ">" | "<"

LBRACE: "{"
RBRACE: "}"

// Keyword terminals intentionally remain explicit. Lark's contextual lexer
// prevents keywords from stealing an IDENT where an identifier is expected.
// Because of that, a keyword that is not valid at the current position (for
// example `else` at the start of a statement) lexes as an IDENT; the semantic
// analyzer rejects such names (see RESERVED_WORDS in semantics.py).
PRINT: "print"
INPUT: "input"
IF: "if"
ELIF: "elif"
ELSE: "else"
WHILE: "while"
LABEL: "label"
GOTO: "goto"
TRUE: "true"
FALSE: "false"
AND: "and"
OR: "or"
NOT: "not"

// Type names. All of them are reserved now, including ones the language does
// not support yet, so a program that uses one as a variable name today does
// not break later. Unused ones still lex as IDENT and semantics rejects them.
I8: "i8"
I16: "i16"
I32: "i32"
I64: "i64"
U8: "u8"
U16: "u16"
U32: "u32"
U64: "u64"
F16: "f16"
F32: "f32"
F64: "f64"
F128: "f128"
BOOL: "bool"
CHAR: "char"
BYTE: "byte"
STR: "str"

STRING: /"([^"\\\n\r]|\\["\\nrt])*"/
// Number literals use Python 3 syntax, `_` separators included. A decimal
// integer cannot start with 0 (`017`), because in C that would be octal; the
// parser explains the error. FLOAT_LIT is tried first (higher priority), so
// `1.5` is never lexed as `1` followed by something else. A trailing `f`
// makes an f32 literal; it is only allowed on float syntax, so `0x1f` is hex.
INT_LIT.2: /0[xX](?:_?[0-9a-fA-F])+|0[oO](?:_?[0-7])+|0[bB](?:_?[01])+|[1-9](?:_?[0-9])*|0(?:_?0)*(?![0-9])/
FLOAT_LIT.3: /(?:(?:[0-9](?:_?[0-9])*)?\.[0-9](?:_?[0-9])*|[0-9](?:_?[0-9])*\.)(?:[eE][+-]?[0-9](?:_?[0-9])*)?f?|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*f?/
IDENT: /[A-Za-z_][A-Za-z0-9_]*/

COMMENT: /#[^\n\r]*/
_NL: /\r?\n/
%ignore /[ \t\r]+/
%ignore COMMENT
